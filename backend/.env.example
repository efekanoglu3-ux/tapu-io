# TAPU.IO Backend Environment Variables
# Kopyala: cp .env.example .env

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8081

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://tapu_user:password@localhost:5432/tapu_io"

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── BLOCKCHAIN (Polygon) ──────────────────────────────────────────────────────
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_TESTNET_RPC_URL="https://rpc-mumbai.maticvigil.com"
PLATFORM_PRIVATE_KEY="your-private-key"
TAPU_TOKEN_CONTRACT="0x..."
PLATFORM_WALLET="0x..."

# ── İYZİCO ───────────────────────────────────────────────────────────────────
IYZICO_API_KEY="your-iyzico-api-key"
IYZICO_SECRET_KEY="your-iyzico-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# ── AWS S3 (Belge Depolama) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="eu-central-1"
AWS_S3_BUCKET="tapu-io-documents"

# ── KYC (Jumio veya Onfido) ───────────────────────────────────────────────────
KYC_PROVIDER="jumio"
KYC_API_KEY="your-kyc-api-key"
KYC_API_SECRET="your-kyc-secret"

# ── PUSH NOTIFICATION ─────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN="your-expo-access-token"

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL="debug"
